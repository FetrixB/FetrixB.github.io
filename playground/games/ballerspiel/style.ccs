@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
.build-tag{font:9px 'DM Mono',monospace;letter-spacing:.8px;color:#8d9688;border:1px solid #343b34;padding:8px 10px}
:root{color-scheme:dark;--bg:#111512;--panel:#171c18;--line:#343b34;--muted:#91988f;--lime:#c8f169;--blue:#72a6ff;--red:#ff786d;--mono:'DM Mono',monospace;--display:'Barlow Condensed',sans-serif;--body:'Manrope',sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f0f2ec;font-family:var(--body);min-height:100vh}button,input{font:inherit}button{color:inherit;cursor:pointer}.app-shell{max-width:1600px;margin:auto;padding:0 5.2vw;min-height:100vh;display:flex;flex-direction:column}.topbar{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff12}.brand{text-decoration:none;color:#f3f4ef;display:flex;align-items:center;gap:11px;font:800 19px var(--display);letter-spacing:2px}.brand-mark{display:grid;place-items:center;width:27px;height:27px;background:var(--lime);color:#111512;font:900 18px var(--display);clip-path:polygon(0 0,100% 0,100% 70%,70% 100%,0 100%)}.brand-dot{color:var(--lime)}.top-note,.icon-button,.eyebrow,.field-label,.segmented,.primary-button,.secondary-button,.connection-status,.lobby-footer,.site-footer,.art-label,.art-coordinate,.code-box button,.invite-state,.text-button,.player-name,.round-label,.round-number,.weapon-copy small,.weapon-stat,.control-hints,.game-toast,.round-overlay p{font-family:var(--mono)}.top-note{font-size:10px;letter-spacing:1.1px;color:#a7ada4}.live-dot{width:7px;height:7px;display:inline-block;border-radius:50%;background:var(--lime);box-shadow:0 0 12px #c8f1698a;margin-right:8px}.icon-button{background:none;border:1px solid var(--line);width:35px;height:35px;border-radius:50%;font-size:17px;color:#bec3ba}.screen{flex:1}.lobby-screen{position:relative;display:grid;grid-template-columns:1fr 1.05fr;align-items:center;min-height:625px;padding:35px 0 67px}.hero-copy{z-index:1;padding:0 0 7px 2.8vw}.eyebrow{font-size:10px;letter-spacing:1.4px;color:#a9b0a6}.eyebrow span{color:var(--lime);margin-right:10px}.hero-copy h1,.waiting-card h2{font:800 clamp(54px,7vw,92px)/.89 var(--display);letter-spacing:-1.6px;margin:25px 0 20px}.hero-copy h1 em,.waiting-card h2 em{color:var(--lime);font-style:normal}.hero-sub{color:#a4aaa1;font-size:13px;line-height:1.8}.best-of-picker{margin-top:37px}.field-label{display:block;color:#858d82;font-size:9px;letter-spacing:1.2px;margin-bottom:10px}.segmented{display:flex;gap:5px}.segmented button{background:#181d19;border:1px solid #303731;padding:10px 13px;color:#858c83;font-size:9px;letter-spacing:.6px;transition:.2s}.segmented button.selected{border-color:var(--lime);color:var(--lime);background:#c8f1690c}.lobby-actions{margin-top:23px;max-width:415px}.primary-button{height:50px;background:var(--lime);color:#151911;border:0;padding:0 17px;min-width:206px;display:flex;align-items:center;justify-content:space-between;font-size:10px;font-weight:bold;letter-spacing:.8px;transition:.2s}.primary-button:hover,.accept-button:hover{background:#d9ff87;transform:translateY(-1px)}.button-arrow{font-size:18px}.join-row{display:flex;margin-top:9px;gap:8px}.join-row input{min-width:0;flex:1;background:#171c18;border:1px solid #343b34;color:#ecf0e9;padding:0 14px;height:45px;font:10px var(--mono);letter-spacing:.8px;outline:none}.join-row input:focus{border-color:#8da969}.join-row input::placeholder{color:#6f766d}.secondary-button{background:transparent;border:1px solid #424a41;padding:0 13px;color:#d1d5cd;font-size:9px;letter-spacing:.6px}.secondary-button span{color:var(--lime);font-size:16px;margin-left:8px}.connection-status{font-size:9px;letter-spacing:.3px;color:#8e968b;margin-top:18px;display:flex;align-items:center;gap:7px}.status-icon{font-size:16px;color:var(--lime)}.hero-art{height:470px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 53% 48%,#28332a 0,#1a211b 37%,#141915 73%);border:1px solid #ffffff0b}.art-grid{position:absolute;inset:0;background-image:linear-gradient(#9daa8d0a 1px,transparent 1px),linear-gradient(90deg,#9daa8d0a 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(90deg,transparent,#000 23%,#000 78%,transparent)}.art-ring{position:absolute;left:50%;top:50%;border:1px solid #b0d36e1c;border-radius:50%;transform:translate(-50%,-50%) rotateX(64deg)}.ring-one{width:410px;height:410px}.ring-two{width:290px;height:290px;border-style:dashed;border-color:#a1c26927}.arena-platform{position:absolute;width:375px;height:215px;left:50%;top:54%;transform:translate(-50%,-50%) rotate(-23deg) skewX(10deg);filter:drop-shadow(0 30px 25px #090c0a9c)}.platform-top{position:absolute;inset:0;background:linear-gradient(135deg,#4b5948,#26342b 48%,#39483a);clip-path:polygon(22% 0,100% 21%,78% 100%,0 76%);border:1px solid #93ad711c}.platform-top:after{content:"";position:absolute;inset:16px;background:linear-gradient(90deg,transparent 49.7%,#d0ea8823 50%,transparent 50.4%),linear-gradient(0deg,transparent 49.7%,#d0ea8823 50%,transparent 50.4%);clip-path:polygon(22% 0,100% 21%,78% 100%,0 76%)}.platform-side{position:absolute;inset:16px -1px -17px 1px;background:linear-gradient(90deg,#1a211b,#2b382b);clip-path:polygon(0 76%,78% 100%,78% 92%,0 68%)}.platform-shadow{position:absolute;inset:0;clip-path:polygon(78% 100%,100% 21%,100% 30%,79% 109%);background:#151c16}.fighter{position:absolute;width:45px;height:100px;top:48%;z-index:2;filter:drop-shadow(0 7px 4px #0b0e0c66)}.fighter-blue{left:31%;transform:rotate(-20deg)}.fighter-red{right:28%;top:39%;transform:scale(.88) rotate(19deg)}.fighter-head{position:absolute;top:0;left:13px;width:21px;height:21px;border-radius:50%;background:#d1bca1;border:3px solid #27312a}.fighter-body{position:absolute;top:19px;left:7px;width:33px;height:43px;background:linear-gradient(110deg,#7598b1,#385570);clip-path:polygon(18% 0,83% 0,100% 88%,60% 100%,0 78%)}.fighter-red .fighter-body{background:linear-gradient(110deg,#cb776b,#713b38)}.fighter-leg{position:absolute;top:53px;width:11px;height:38px;background:#27302b;transform-origin:top}.leg-a{left:11px;transform:rotate(9deg)}.leg-b{left:26px;transform:rotate(-13deg)}.art-label{position:absolute;font-size:9px;color:#8c9886;letter-spacing:1px}.art-label b{display:block;font-size:8px;color:var(--lime);font-weight:400;margin-top:5px}.label-left{left:13%;bottom:21%}.label-right{right:13%;top:22%;text-align:right}.label-right b{color:#ff9289}.art-crosshair{position:absolute;top:32%;left:55%;color:#daff91;font-size:22px;font-family:var(--mono);opacity:.8}.art-coordinate{position:absolute;bottom:17px;right:19px;font-size:8px;line-height:1.8;color:#6f796e;letter-spacing:.8px;text-align:right}.lobby-footer{position:absolute;bottom:26px;left:2.8vw;right:0;display:flex;gap:27px;color:#a4aaa0;font-size:8px;letter-spacing:.5px}.lobby-footer i{font-style:normal;color:#697268;margin-left:5px}.site-footer{height:53px;border-top:1px solid #ffffff12;display:flex;align-items:center;justify-content:space-between;color:#777e74;font-size:8px;letter-spacing:.8px}.site-footer b{color:#4f574e;font-weight:400;margin-left:8px}.hidden{display:none!important}.waiting-screen{display:grid;place-items:center;min-height:620px}.waiting-card{width:min(560px,100%);text-align:center;padding:45px 30px}.pulse-rings{width:70px;height:70px;margin:0 auto 25px;border:1px solid #c8f16942;border-radius:50%;display:grid;place-items:center;color:var(--lime);font-size:26px;box-shadow:0 0 0 9px #c8f1690a,0 0 0 18px #c8f16906}.waiting-card h2{font-size:58px;margin:16px 0}.muted{font-size:12px;color:#929a90;line-height:1.7;max-width:400px;margin:0 auto 25px}.code-box{margin:0 auto;max-width:390px;display:flex;align-items:center;justify-content:space-between;background:#1a201b;border:1px solid #384137;padding:8px 10px 8px 20px}.code-box>span{font:500 15px var(--mono);letter-spacing:3px;color:var(--lime)}.code-box button{border:0;background:#2b352b;color:#d8e0d2;padding:10px 12px;font-size:9px;letter-spacing:.6px}.invite-state{font-size:9px;color:#a2a99f;letter-spacing:.8px;margin:23px}.text-button{background:transparent;border:0;color:#777f75;font-size:9px;letter-spacing:.7px;margin-top:25px}.request-card{max-width:440px;margin:22px auto 0;text-align:left;padding:16px;background:#1b211c;border:1px solid #596744;box-shadow:0 0 35px #c8f1690b}.request-card>div:first-child{display:grid;gap:7px}.request-card b{font-size:12px}.request-buttons{display:flex;gap:8px;margin-top:15px}.request-buttons button{flex:1;height:38px;font:9px var(--mono);letter-spacing:.5px}.decline-button{background:transparent;border:1px solid #41483f;color:#a4aaa0}.accept-button{background:var(--lime);border:0;color:#171b14}.game-screen{padding:17px 0 20px;flex:1;display:flex;flex-direction:column;min-height:calc(100vh - 136px)}.game-hud{display:grid;grid-template-columns:1fr 140px 1fr;align-items:center;gap:20px;max-width:1200px;width:100%;margin:0 auto 14px}.player-hud{display:flex;align-items:center;gap:12px}.player-hud.opponent{justify-content:flex-end}.avatar{width:35px;height:35px;display:grid;place-items:center;font:700 12px var(--mono);border:1px solid}.avatar-blue{color:var(--blue);border-color:#72a6ff64;background:#72a6ff10}.avatar-red{color:var(--red);border-color:#ff786d64;background:#ff786d10}.health-info{flex:1;max-width:250px}.player-name{font-size:10px;letter-spacing:.8px;color:#e1e5dc}.player-name span{font-size:8px;color:#757d73;margin-left:5px}.health-track{height:4px;background:#333a33;margin-top:7px}.health-track i{display:block;background:var(--blue);height:100%;width:100%;transition:width .2s}.opponent .health-track i{background:var(--red)}.player-hud>strong{font:500 21px var(--display);color:var(--blue)}.opponent>strong{color:var(--red)}.match-center{text-align:center}.round-label,.round-number{font-size:8px;letter-spacing:1px;color:#858e82}.score-display{font:700 24px var(--display);display:flex;justify-content:center;gap:9px;line-height:1.2}.score-display b{color:#5f685d;font-weight:400}.round-number{font-size:7px;margin-top:2px;color:var(--lime)}.scene-wrap{position:relative;flex:1;min-height:350px;max-height:calc(100vh - 290px);background:#1a211c;border:1px solid #ffffff18;overflow:hidden;cursor:crosshair}.scene-wrap canvas{display:block;width:100%;height:100%}.crosshair{position:absolute;left:50%;top:50%;width:13px;height:13px;border:1px solid #e6f2d8b0;border-radius:50%;transform:translate(-50%,-50%);pointer-events:none;opacity:.65}.crosshair:after,.crosshair:before{content:"";position:absolute;background:#e6f2d8a8}.crosshair:after{width:1px;height:21px;left:5px;top:-5px}.crosshair:before{height:1px;width:21px;left:-5px;top:5px}.game-toast{position:absolute;left:50%;top:17px;transform:translateX(-50%);padding:9px 13px;background:#111512de;border:1px solid #ffffff18;font-size:9px;letter-spacing:.7px;color:#e8eee1}.round-overlay{position:absolute;inset:0;background:#101510bd;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;backdrop-filter:blur(4px)}.round-overlay .eyebrow{color:var(--lime)}.round-overlay h2{font:800 clamp(46px,8vw,78px)/.9 var(--display);margin:7px 0}.round-overlay>p:last-child{font-size:10px;color:#a4aca0}.game-bottom{max-width:1200px;width:100%;margin:13px auto 0}.weapon-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.weapon-card{height:57px;border:1px solid #343b34;background:#191e1a;display:flex;align-items:center;text-align:left;padding:0 10px;gap:9px;position:relative;transition:.15s}.weapon-card.selected{border-color:#a5cb5e;background:#222b20}.weapon-key{position:absolute;left:5px;top:4px;color:#697267;font:8px var(--mono)}.weapon-icon{font:22px var(--display);color:#aeb8a5;width:24px;text-align:center;margin-left:8px}.weapon-card.selected .weapon-icon{color:var(--lime)}.weapon-copy{display:grid;gap:3px}.weapon-copy b{font:700 10px var(--display);letter-spacing:.7px}.weapon-copy small{font-size:7px;color:#737c71;letter-spacing:.2px}.weapon-stat{font-size:8px;color:#8f9988;margin-left:auto}.weapon-card.selected .weapon-stat{color:var(--lime)}.control-hints{display:flex;align-items:center;gap:20px;margin-top:12px;color:#7f877c;font-size:8px;letter-spacing:.4px}.control-hints kbd{font:8px var(--mono);color:#bec5b8;border:1px solid #3a4239;padding:4px 5px;margin-right:4px}.control-hints button{margin-left:auto;background:transparent;border:0;color:#7f877c;font:8px var(--mono);letter-spacing:.5px}.control-hints button:hover{color:var(--red)}
.signal-note{font:7px var(--mono);letter-spacing:.35px;color:#667063;margin:13px 0 0}.waiting-card .signal-note{margin-top:18px}
@media(max-width:850px){.app-shell{padding:0 22px}.lobby-screen{grid-template-columns:1fr;min-height:auto;padding:58px 0 78px}.hero-copy{padding:0;max-width:550px}.hero-art{position:absolute;right:0;top:94px;width:48%;height:340px;opacity:.62}.hero-copy{position:relative;z-index:2}.hero-copy h1{font-size:70px}.hero-sub{max-width:310px}.lobby-footer{left:0;gap:14px}.scene-wrap{max-height:calc(100vh - 330px)}.control-hints{gap:10px}.control-hints span{font-size:7px}.game-hud{grid-template-columns:1fr 100px 1fr;gap:9px}.player-hud{gap:7px}.player-name span{display:none}}
@media(max-width:560px){.app-shell{padding:0 14px}.topbar{height:62px}.top-note{font-size:8px}.lobby-screen{padding:54px 0 76px}.hero-copy h1{font-size:60px;margin-top:18px}.hero-sub{font-size:11px}.hero-art{top:92px;right:-80px;width:70%;height:290px;opacity:.34}.best-of-picker{margin-top:28px}.segmented button{padding:9px 10px}.lobby-actions{max-width:100%}.lobby-footer{font-size:7px;bottom:19px;gap:10px}.lobby-footer i{display:block;margin:5px 0 0}.site-footer{height:43px;font-size:7px}.waiting-card{padding:35px 0}.waiting-card h2{font-size:47px}.game-screen{min-height:calc(100vh - 105px);padding-top:11px}.game-hud{grid-template-columns:1fr 64px 1fr;gap:5px;margin-bottom:10px}.avatar{width:27px;height:27px;font-size:9px}.player-hud{gap:5px}.player-name{font-size:8px}.player-name span{display:none}.player-hud>strong{font-size:16px}.round-label{font-size:6px}.score-display{font-size:21px}.round-number{font-size:6px}.scene-wrap{min-height:300px;max-height:calc(100vh - 350px)}.weapon-bar{grid-template-columns:1fr 1fr;gap:5px}.weapon-card{height:47px;padding:0 6px;gap:5px}.weapon-icon{font-size:19px;width:20px;margin-left:8px}.weapon-copy b{font-size:9px}.weapon-copy small{font-size:6px}.weapon-stat{font-size:7px}.control-hints{justify-content:space-between;gap:0;font-size:0}.control-hints span:nth-child(2){display:none}.control-hints kbd{font-size:7px}.control-hints button{font-size:7px}.round-overlay h2{font-size:50px}}
